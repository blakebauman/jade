{
	"name": "@jade/web",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 5190",
		"build": "vite build",
		"preview": "pnpm build && vite preview",
		"lint": "biome check .",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:e2e:offline": "playwright test --config playwright.offline.config.ts",
		"typecheck": "tsc --noEmit",
